# Runtime
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000

# Local infrastructure (safe development defaults; replace outside local use)
POSTGRES_DB=soloshot
POSTGRES_USER=soloshot
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://soloshot:local-development-only@localhost:5432/soloshot
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=soloshot-media
OBJECT_STORAGE_ACCESS_KEY=soloshot-local
OBJECT_STORAGE_SECRET_KEY=local-development-only
MEDIA_RETENTION_HOURS=24
MEDIA_UPLOAD_TTL_SECONDS=600
MEDIA_ACCESS_TTL_SECONDS=300

# W2 hybrid mode keeps presets on explicit Fixture and routes custom media to Volcengine Ark.
# Fill ARK_API_KEY and ARK_MODEL_ID manually before using Live paths.
# Live calls may incur external model charges; the default CI suite never makes them.
# W5 uploads only the explicitly selected JPEG. Original MOV files and unselected frames stay on-device.
MODEL_PROVIDER=hybrid
ARK_API_KEY=
ARK_MODEL_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT_SECONDS=8
SKILL_TIMEOUT_SECONDS=8
H5_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Replace before any shared or deployed environment
MEDIA_SIGNING_SECRET=replace-me
HANDOFF_SIGNING_SECRET=replace-me

# W3 H5 -> iPhone handoff. PUBLIC_HANDOFF_BASE_URL must be HTTPS on a shared test environment.
PUBLIC_HANDOFF_BASE_URL=http://127.0.0.1:5173/handoff
HANDOFF_TTL_SECONDS=600
HANDOFF_CLAIM_TOKEN_TTL_SECONDS=86400
HANDOFF_LOOKUP_LIMIT_PER_MINUTE=120
HANDOFF_CLAIM_LIMIT_PER_MINUTE=10

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Honest feature state
MOCK_AI_ENABLED=false
DEMO_PRESET_ENABLED=true

# H5 public configuration only; never put secrets in VITE_* variables
VITE_API_BASE_URL=http://localhost:8000
