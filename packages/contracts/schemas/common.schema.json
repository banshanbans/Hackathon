{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "NormalizedPoint": {
      "type": "object",
      "description": "Normalized screen-space point. Origin is top-left; x grows right and y grows down.",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "NormalizedBoundingBox": {
      "type": "object",
      "description": "Normalized screen-space bounding box. Origin is top-left; x grows right and y grows down.",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "SkillRef": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "reference_understanding",
            "shooting_plan",
            "scene_adaptation",
            "result_evaluation",
            "coaching_decision",
            "content_composer",
            "growth_analytics"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "UserConstraints": {
      "type": "object",
      "required": ["solo_traveler", "tripod_available", "has_luggage"],
      "properties": {
        "solo_traveler": { "type": "boolean" },
        "tripod_available": { "type": "boolean" },
        "has_luggage": { "type": "boolean" },
        "notes": { "type": ["string", "null"], "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "SourceChannel": {
      "type": "string",
      "enum": ["h5_qr", "h5_direct", "ios", "demo_preset", "shared_link"]
    },
    "Client": {
      "type": "string",
      "enum": ["h5", "ios", "api"]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "REFERENCE_NO_PERSON",
        "REFERENCE_MULTIPLE_PEOPLE",
        "REFERENCE_PARSE_FAILED",
        "MODEL_TIMEOUT",
        "INVALID_JSON",
        "LOW_CONFIDENCE",
        "CAPTURE_UPLOAD_FAILED",
        "COMPARE_FAILED",
        "VIDEO_RENDER_FAILED",
        "HANDOFF_EXPIRED",
        "HANDOFF_ALREADY_CLAIMED",
        "SESSION_EXPIRED",
        "UNSUPPORTED_MEDIA",
        "SCHEMA_VERSION_UNSUPPORTED",
        "VALIDATION_FAILED",
        "NOT_FOUND",
        "INTERNAL_ERROR"
      ]
    },
    "ApiError": {
      "type": "object",
      "required": ["schema_version", "request_id", "code", "message", "recoverable"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "recoverable": { "type": "boolean" },
        "retry_after": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
