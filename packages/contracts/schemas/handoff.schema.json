{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "HandoffTask": {
      "title": "HandoffTask",
      "type": "object",
      "description": "Safe public handoff status. Session data is returned only after a successful claim.",
      "required": [
        "schema_version",
        "handoff_id",
        "code",
        "status",
        "mode",
        "created_at",
        "expires_at",
        "claimed_at",
        "completed_at"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "handoff_id": { "type": "string", "pattern": "^handoff_[A-Za-z0-9_-]+$" },
        "code": { "type": "string", "pattern": "^[0-9]{6}$" },
        "status": { "type": "string", "enum": ["created", "claimed", "completed", "revoked", "expired"] },
        "mode": { "type": "string", "enum": ["original_replication", "scene_adaptation"] },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "claimed_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/HandoffTask"
}
