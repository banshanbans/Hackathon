{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Attribution": {
      "type": "object",
      "required": ["source_label", "creator_label"],
      "properties": {
        "source_label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "creator_label": { "type": ["string", "null"], "maxLength": 100 },
        "source_url": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    },
    "ReferenceAsset": {
      "type": "object",
      "required": [
        "schema_version",
        "reference_id",
        "media_type",
        "source_type",
        "width",
        "height",
        "selected_box",
        "attribution"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "reference_id": { "type": "string", "pattern": "^ref_[A-Za-z0-9_-]+$" },
        "media_type": { "type": "string", "enum": ["image", "video_frame"] },
        "source_type": { "type": "string", "enum": ["upload", "preset"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "selected_box": { "$ref": "common.schema.json#/$defs/NormalizedBoundingBox" },
        "attribution": { "$ref": "#/$defs/Attribution" }
      },
      "additionalProperties": false
    },
    "ReferenceAnalysis": {
      "type": "object",
      "required": [
        "schema_version",
        "analysis_id",
        "reference_id",
        "person_count",
        "target_layout",
        "composition_notes",
        "confidence"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "analysis_id": { "type": "string", "pattern": "^ra_[A-Za-z0-9_-]+$" },
        "reference_id": { "type": "string", "pattern": "^ref_[A-Za-z0-9_-]+$" },
        "person_count": { "type": "integer", "minimum": 0 },
        "target_layout": { "$ref": "shot-plan.schema.json#/$defs/TargetLayout" },
        "composition_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "maxItems": 10
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
