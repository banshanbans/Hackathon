APP_ENV=production
PUBLIC_BASE_URL=https://shotapi.socialdog.cn

POSTGRES_DB=soloshot
POSTGRES_USER=soloshot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://soloshot:replace-with-a-long-random-password@postgres:5432/soloshot
REDIS_URL=redis://redis:6379/0

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://shotapi.socialdog.cn
OBJECT_STORAGE_BUCKET=soloshot-media
OBJECT_STORAGE_ACCESS_KEY=soloshot
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-password
MEDIA_RETENTION_HOURS=24
MEDIA_UPLOAD_TTL_SECONDS=600
MEDIA_ACCESS_TTL_SECONDS=300

MODEL_PROVIDER=hybrid
ARK_API_KEY=
ARK_MODEL_ID=doubao-seed-2-1-turbo-260628
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT_SECONDS=25
SKILL_TIMEOUT_SECONDS=30
MOCK_AI_ENABLED=false
DEMO_PRESET_ENABLED=true

H5_ALLOWED_ORIGINS=https://shot.socialdog.cn
HANDOFF_SIGNING_SECRET=replace-with-a-random-32-character-minimum-secret
PUBLIC_HANDOFF_BASE_URL=https://shot.socialdog.cn/handoff
HANDOFF_TTL_SECONDS=600
HANDOFF_CLAIM_TOKEN_TTL_SECONDS=86400
HANDOFF_LOOKUP_LIMIT_PER_MINUTE=120
HANDOFF_CLAIM_LIMIT_PER_MINUTE=10
