{
  "name": "soloshot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SoloShot AI contract-first monorepo",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/h5"
  ],
  "scripts": {
    "generate:h5": "openapi-typescript packages/contracts/openapi.yaml -o apps/h5/src/generated/api.ts",
    "generate:swift": "./scripts/generate-swift-contracts.sh",
    "generate:python": "./scripts/generate-python-contracts.sh"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.39.1",
    "openapi-typescript": "7.9.1"
  }
}
